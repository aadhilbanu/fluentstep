# Copy this file to .env and fill in the values. Never commit .env.

# Anthropic API key — powers the AI English Coach (conversation, corrections,
# translation checking, interview feedback). Get one at https://console.anthropic.com
# Without a key, FluentStep runs in "Offline coach" mode with rule-based feedback.
ANTHROPIC_API_KEY=

# Optional: model used by the coach (default: claude-opus-5-5)
# ANTHROPIC_MODEL=claude-opus-5-5

# ---- Deployment (production) ----
# Free hosted database from https://turso.tech. Leave empty to use a local file in ./data.
# TURSO_DATABASE_URL=libsql://your-db-name-your-org.turso.io
# TURSO_AUTH_TOKEN=
# Set to production on the hosting server (enables secure cookies).
# NODE_ENV=production
# Shown on the Terms page so users can contact you.
# CONTACT_EMAIL=you@example.com

# Optional: server port (default 3000)
# PORT=3000

# Optional: this email becomes an administrator on sign-up (can add approved video URLs).
# If unset, the first registered account becomes the administrator.
# ADMIN_EMAIL=you@example.com
